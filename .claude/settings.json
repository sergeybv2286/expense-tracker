{
  "plansDirectory": "./.claude/.plans",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_response.filePath // .tool_input.file_path'); p=\"$CLAUDE_PROJECT_DIR/node_modules/.bin/prettier\"; { [ -x \"$p\" ] && [ -n \"$f\" ] && \"$p\" --write --ignore-unknown \"$f\"; } >/dev/null 2>&1 || true",
            "timeout": 30,
            "statusMessage": "Prettier"
          }
        ]
      }
    ]
  }
}
